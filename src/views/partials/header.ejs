<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Shows Review' %></title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <div class="nav-logo">
                <a href="/">📺 Shows Review</a>
            </div>
            <ul class="nav-menu">
                <li class="nav-item">
                    <a href="/" class="nav-link <%= currentPage === 'home' ? 'active' : '' %>">Home</a>
                </li>
                <li class="nav-item">
                    <a href="/movies" class="nav-link <%= currentPage === 'movies' ? 'active' : '' %>">Movies</a>
                </li>
                <li class="nav-item">
                    <a href="/tv-shows" class="nav-link <%= currentPage === 'tv-shows' ? 'active' : '' %>">TV Shows</a>
                </li>
                <% if (locals.isAuthenticated) { %>
                    <% if (locals.user && locals.user.isAdmin) { %>
                        <li class="nav-item">
                            <a href="/admin" class="nav-link <%= currentPage === 'admin' ? 'active' : '' %>">Admin</a>
                        </li>
                    <% } %>
                    <li class="nav-item">
                        <a href="/dashboard" class="nav-link <%= currentPage === 'dashboard' ? 'active' : '' %>">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a href="/auth/logout" class="nav-link">Sign Out (<%= user.username %>)</a>
                    </li>
                <% } else { %>
                    <li class="nav-item">
                        <a href="/auth/login" class="nav-link <%= currentPage === 'login' ? 'active' : '' %>">Sign In</a>
                    </li>
                    <li class="nav-item">
                        <a href="/auth/register" class="nav-link <%= currentPage === 'register' ? 'active' : '' %>">Sign Up</a>
                    </li>
                <% } %>
            </ul>
        </div>
    </nav>
    <main class="container">
        <% if (typeof flash !== 'undefined') {
            const messages = flash();
            const types = ['success', 'error', 'warning', 'info'];
            types.forEach(type => {
                if (messages[type] && messages[type].length > 0) {
                    messages[type].forEach(message => { %>
                        <div class="flash-message flash-<%= type %>">
                            <%= message %>
                        </div>
                    <% });
                }
            });
        } %>
