<%- include('../partials/header', { title: title, currentPage: 'rating' }) %>

<div class="container">
    <div class="form-container">
        <div class="form-header">
            <h1><%= existingReview ? 'Update Your Rating' : 'Rate This Show' %></h1>
            <p><%= show.name %> (<%= show.start_date %>)</p>
        </div>

        <% if (isGuest) { %>
            <div style="background: #2a3f5f; border: 2px solid #3a5f8f; border-radius: 8px; padding: 1.5rem; margin-bottom: 1.5rem;">
                <h3 style="margin: 0 0 0.5rem 0; color: #4a9eff;">⚠️ Posting as Guest</h3>
                <p style="margin: 0; color: #b4b8c5;">
                    Guest reviews cannot be edited or deleted.
                    <a href="/auth/login?redirect=/rate/<%= show.id %>" style="color: #4a9eff; text-decoration: underline;">Login</a> to manage your reviews.
                </p>
            </div>
        <% } %>

        <% if (errors && errors.length > 0) { %>
            <div class="form-error">
                <ul>
                    <% errors.forEach(error => { %>
                        <li><%= error.msg %></li>
                    <% }) %>
                </ul>
            </div>
        <% } %>

        <form action="/rate/<%= show.id %>" method="POST">
            <div class="form-group">
                <label for="score">Rating (1-10) *</label>
                <input
                    type="number"
                    id="score"
                    name="score"
                    min="1"
                    max="10"
                    step="0.5"
                    placeholder="Enter rating from 1 to 10"
                    value="<%= formData.score || '' %>"
                    required
                >
                <small style="color: #b4b8c5; display: block; margin-top: 0.5rem;">
                    Enter a rating between 1 (worst) and 10 (best)
                </small>
            </div>

            <div class="form-group">
                <label for="description">Review (Optional)</label>
                <textarea
                    id="description"
                    name="description"
                    rows="6"
                    placeholder="Share your thoughts about this show..."
                    style="width: 100%; padding: 0.8rem; background: #242938; border: 2px solid #2a3040; color: #e4e6eb; font-size: 1rem; font-family: inherit; resize: vertical;"
                ><%= formData.description || '' %></textarea>
            </div>

            <button type="submit" class="btn-submit">
                <%= existingReview ? 'Update Rating' : 'Submit Rating' %>
            </button>
        </form>

        <div class="form-footer">
            <p>
                <a href="/<%= show.media_type === 'movie' ? 'movies' : 'tv-shows' %>">
                    Cancel and go back
                </a>
            </p>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
