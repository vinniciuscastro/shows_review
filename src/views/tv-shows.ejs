<%- include('partials/header', { title: 'TV Shows - Shows Review', currentPage: 'tv-shows' }) %>

<div class="page-header">
    <h1>📺 TV Shows</h1>
    <p>Discover and review popular TV series</p>
</div>

<div class="content-section">
    <div class="shows-grid">
        <% if (shows && shows.length > 0) { %>
            <% shows.forEach(show => { %>
                <div class="show-box">
                    <% if (show.image_url) { %>
                        <img src="<%= show.image_url %>" alt="<%= show.name %>" class="show-image">
                    <% } else { %>
                        <div class="show-image">📺</div>
                    <% } %>
                    <div class="show-info">
                        <h3><%= show.name %></h3>
                        <p class="show-meta">
                            <%= show.start_date %><% if (show.end_date) { %>-<%= show.end_date %><% } else { %>-Present<% } %>
                            <% if (show.genres && show.genres.length > 0) { %>
                                • <%= show.genres.join(', ') %>
                            <% } %>
                        </p>
                        <p class="show-rating">⭐ <%= show.average_score %>/10 (<%= show.review_count %> reviews)</p>
                        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                            <a href="/reviews/<%= show.id %>" class="btn btn-small" style="background: #3a4050;">View Reviews</a>
                            <% if (locals.isAuthenticated) { %>
                                <a href="/rate/<%= show.id %>" class="btn btn-small">Rate Show</a>
                            <% } else { %>
                                <a href="/review-choice/<%= show.id %>" class="btn btn-small">Rate Show</a>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <p>No TV shows found. Please run the database setup script.</p>
        <% } %>
    </div>
</div>

<div class="info-box">
    <p><strong>Success!</strong> TV shows are now loaded from the database!</p>
</div>

<%- include('partials/footer') %>
