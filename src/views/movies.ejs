<%- include('partials/header', { title: 'Movies - Shows Review', currentPage: 'movies' }) %>

<div class="page-header">
    <h1>🎬 Movies</h1>
    <p>Browse and review your favorite movies</p>
</div>

<div class="content-section">
    <div class="shows-grid">
        <% if (shows && shows.length > 0) { %>
            <% shows.forEach(show => { %>
                <div class="show-box">
                    <div class="show-image">🎬</div>
                    <div class="show-info">
                        <h3><%= show.name %></h3>
                        <p class="show-meta">
                            <%= show.start_date %><% if (show.end_date && show.end_date !== show.start_date) { %>-<%= show.end_date %><% } %>
                            <% if (show.genres && show.genres.length > 0) { %>
                                • <%= show.genres.join(', ') %>
                            <% } %>
                        </p>
                        <p class="show-rating">⭐ <%= show.average_score %>/10 (<%= show.vote_count %> votes)</p>
                        <a href="#" class="btn btn-small">View Details</a>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <p>No movies found. Please run the database setup script.</p>
        <% } %>
    </div>
</div>

<div class="info-box">
    <p><strong>Success!</strong> Movies are now loaded from the database!</p>
</div>

<%- include('partials/footer') %>
