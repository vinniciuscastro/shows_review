<%- include('../../partials/header', { title: 'My Dashboard', currentPage: 'dashboard' }) %>

<div class="page-header">
    <h1>My Dashboard</h1>
    <p>Welcome back, <%= user.firstName %>!</p>
</div>

<div class="content-section">
    <h2>My Reviews (<%= reviews.length %>)</h2>

    <% if (reviews && reviews.length > 0) { %>
        <div class="shows-grid">
            <% reviews.forEach(review => { %>
                <div class="show-box">
                    <% if (review.image_url) { %>
                        <img src="<%= review.image_url %>" alt="<%= review.show_name %>" class="show-image" style="width: 100%; height: 200px; object-fit: cover;">
                    <% } else { %>
                        <div class="show-image"><%= review.media_type === 'movie' ? '🎬' : '📺' %></div>
                    <% } %>
                    <div class="show-info">
                        <h3><%= review.show_name %></h3>
                        <p class="show-meta">
                            <%= review.start_date %> • <%= review.media_type === 'movie' ? 'Movie' : 'TV Show' %>
                        </p>
                        <p class="show-rating">⭐ My Rating: <%= review.score %>/10</p>
                        <% if (review.description) { %>
                            <p style="color: #b4b8c5; margin: 0.5rem 0; font-size: 0.9rem;">
                                "<%= review.description.substring(0, 100) %><%= review.description.length > 100 ? '...' : '' %>"
                            </p>
                        <% } %>
                        <p style="color: #888; font-size: 0.85rem; margin-top: 0.5rem;">
                            Reviewed on <%= new Date(review.created_at).toLocaleDateString() %>
                        </p>
                        <div style="display: flex; gap: 0.5rem; margin-top: 1rem;">
                            <a href="/rate/<%= review.show_id %>" class="btn btn-small">Edit Review</a>
                            <form action="/review/delete/<%= review.show_id %>" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this review?');">
                                <button type="submit" class="btn btn-small" style="background: #dc3545; border-color: #dc3545;">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="info-box">
            <p>You haven't reviewed any shows yet!</p>
            <p style="margin-top: 1rem;">
                <a href="/movies" class="btn">Browse Movies</a>
                <a href="/tv-shows" class="btn" style="margin-left: 1rem;">Browse TV Shows</a>
            </p>
        </div>
    <% } %>
</div>

<%- include('../../partials/footer') %>
