<%- include('../partials/header', { title: title, currentPage: currentPage }) %>

<div class="page-header">
    <h1>Admin Panel</h1>
    <p>Manage shows and movies</p>
</div>

<div class="content-section">
    <div style="margin-bottom: 2rem;">
        <a href="/admin/add-show" class="btn">Add New Show/Movie</a>
    </div>

    <h2>All Shows (<%= shows.length %>)</h2>

    <% if (shows && shows.length > 0) { %>
        <table style="width: 100%; border-collapse: collapse; margin-top: 1rem;">
            <thead>
                <tr style="background: #2a3040; border-bottom: 2px solid #3a4050;">
                    <th style="padding: 1rem; text-align: left;">Name</th>
                    <th style="padding: 1rem; text-align: left;">Type</th>
                    <th style="padding: 1rem; text-align: left;">Year</th>
                    <th style="padding: 1rem; text-align: left;">Genres</th>
                    <th style="padding: 1rem; text-align: center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% shows.forEach(show => { %>
                    <tr style="border-bottom: 1px solid #3a4050;">
                        <td style="padding: 1rem;"><%= show.name %></td>
                        <td style="padding: 1rem;"><%= show.media_type === 'movie' ? 'Movie' : 'TV Show' %></td>
                        <td style="padding: 1rem;"><%= show.start_date %><% if (show.end_date && show.end_date !== show.start_date) { %>-<%= show.end_date %><% } %></td>
                        <td style="padding: 1rem;"><%= show.genres ? show.genres.join(', ') : 'N/A' %></td>
                        <td style="padding: 1rem; text-align: center;">
                            <a href="/admin/edit/<%= show.id %>" class="btn btn-small">Edit</a>
                            <form action="/admin/delete/<%= show.id %>" method="POST" style="display: inline; margin-left: 0.5rem;" onsubmit="return confirm('Are you sure you want to delete this show?');">
                                <button type="submit" class="btn btn-small" style="background: #dc3545; border-color: #dc3545;">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } else { %>
        <p>No shows found.</p>
    <% } %>
</div>

<%- include('../partials/footer') %>
