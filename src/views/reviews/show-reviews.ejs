<%- include('../partials/header', { title: title, currentPage: currentPage }) %>

<div class="page-header">
    <h1>Reviews for <%= show.name %></h1>
    <p><%= show.start_date %><% if (show.end_date && show.end_date !== show.start_date) { %> - <%= show.end_date %><% } %> • <%= show.media_type === 'movie' ? 'Movie' : 'TV Show' %></p>
    <p style="margin-top: 0.5rem;">
        <span style="font-size: 1.2rem;">⭐ <%= show.average_score %>/10</span>
        (<%= show.review_count %> <%= show.review_count === 1 ? 'review' : 'reviews' %>)
    </p>
</div>

<div class="content-section">
    <div style="margin-bottom: 2rem;">
        <% if (locals.isAuthenticated) { %>
            <a href="/rate/<%= show.id %>" class="btn">Write a Review</a>
        <% } else { %>
            <a href="/review-choice/<%= show.id %>" class="btn">Write a Review</a>
        <% } %>
        <a href="/<%= show.media_type === 'movie' ? 'movies' : 'tv-shows' %>" class="btn" style="margin-left: 0.5rem; background: #3a4050;">Back to <%= show.media_type === 'movie' ? 'Movies' : 'TV Shows' %></a>
    </div>

    <h2>All Reviews (<%= reviews.length %>)</h2>

    <% if (reviews && reviews.length > 0) { %>
        <div style="margin-top: 1.5rem;">
            <% reviews.forEach(review => { %>
                <div style="background: #242938; border: 2px solid #2a3040; border-radius: 8px; padding: 1.5rem; margin-bottom: 1.5rem;">
                    <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 1rem;">
                        <div>
                            <h3 style="margin: 0; color: #e4e6eb; font-size: 1.1rem;">
                                <% if (review.user_id) { %>
                                    <%= review.first_name %> <%= review.last_name %>
                                    <span style="color: #888; font-size: 0.9rem; font-weight: normal;">(@<%= review.username %>)</span>
                                <% } else { %>
                                    Guest
                                    <span style="background: #3a4050; color: #888; font-size: 0.8rem; font-weight: normal; padding: 0.2rem 0.5rem; border-radius: 4px; margin-left: 0.5rem;">Guest Review</span>
                                <% } %>
                            </h3>
                            <p style="margin: 0.5rem 0 0 0; color: #888; font-size: 0.9rem;">
                                Reviewed on <%= new Date(review.created_at).toLocaleDateString() %>
                            </p>
                        </div>
                        <div style="font-size: 1.5rem; color: #4CAF50; font-weight: bold;">
                            ⭐ <%= review.score %>/10
                        </div>
                    </div>

                    <% if (review.description) { %>
                        <p style="color: #b4b8c5; margin: 1rem 0; line-height: 1.6;">
                            "<%= review.description %>"
                        </p>
                    <% } else { %>
                        <p style="color: #888; margin: 1rem 0; font-style: italic;">
                            No written review
                        </p>
                    <% } %>

                    <% if (review.user_id && locals.isAuthenticated && locals.userId === review.user_id) { %>
                        <!-- User owns this review - can edit and delete -->
                        <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #3a4050;">
                            <a href="/rate/<%= show.id %>" class="btn btn-small">Edit Your Review</a>
                            <form action="/reviews/<%= show.id %>/delete" method="POST" style="display: inline; margin-left: 0.5rem;" onsubmit="return confirm('Are you sure you want to delete your review?');">
                                <button type="submit" class="btn btn-small" style="background: #dc3545; border-color: #dc3545;">Delete Your Review</button>
                            </form>
                        </div>
                    <% } else if (!review.user_id && locals.isAdmin) { %>
                        <!-- Guest review - only admin can delete -->
                        <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #3a4050;">
                            <form action="/admin/delete-review/<%= review.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this guest review? This action cannot be undone.');">
                                <button type="submit" class="btn btn-small" style="background: #dc3545; border-color: #dc3545;">Delete Guest Review (Admin)</button>
                            </form>
                        </div>
                    <% } %>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="info-box">
            <p>No reviews yet. Be the first to review this <%= show.media_type === 'movie' ? 'movie' : 'TV show' %>!</p>
            <p style="margin-top: 1rem;">
                <% if (locals.isAuthenticated) { %>
                    <a href="/rate/<%= show.id %>" class="btn">Write a Review</a>
                <% } else { %>
                    <a href="/review-choice/<%= show.id %>" class="btn">Write a Review</a>
                <% } %>
            </p>
        </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
